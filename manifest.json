{
  "manifest_version": 3,
  "name": "Gemini ABC Piano Roll",
  "version": "1.1.9",
  "description": "Interactive piano roll and synthesizer for ABC notation in Google Gemini and NotebookLM",
  "content_scripts": [
    {
      "matches": [
        "https://notebooklm.google.com/*",
        "https://notebook.google.com/*",
        "https://gemini.google.com/*"
      ],
      "js": [
        "src/smplr.js",
        "src/abc-parser.js",
        "src/midi-parser.js",
        "src/synth.js",
        "src/pianoroll.js",
        "src/detector.js",
        "content.js"
      ],
      "css": [
        "src/styles.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
