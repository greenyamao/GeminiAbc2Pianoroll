{
  "manifest_version": 3,
  "name": "NotebookLM ABC Piano Roll",
  "version": "1.0.1",
  "description": "FL Studio-style Piano Roll and synthesizer for ABC notation in Google NotebookLM",
  "content_scripts": [
    {
      "matches": [
        "https://notebooklm.google.com/*",
        "https://notebook.google.com/*"
      ],
      "js": [
        "src/smplr.js",
        "src/abc-parser.js",
        "src/synth.js",
        "src/pianoroll.js",
        "src/detector.js",
        "content.js"
      ],
      "css": [
        "src/styles.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
